SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=<cole-do-supabase-start>
AI_PROVIDER_API_KEY=<chave-da-llm>

# Edge Function cadu-chat
# Mantenha vazio ou defina CADU_MOCK=true para usar o handler mock
# (responde a partir do banco real via heurística pt-BR, sem custo).
# Em produção, ANTHROPIC_API_KEY deve vir de `supabase secrets set
# ANTHROPIC_API_KEY=...`, NUNCA commitada.
ANTHROPIC_API_KEY=
CADU_MOCK=true
